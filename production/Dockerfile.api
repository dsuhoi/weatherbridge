FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY production/requirements-api.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && useradd --create-home --uid 10001 weatherbridge \
    && mkdir -p /var/lib/weatherbridge \
    && chown -R weatherbridge:weatherbridge /var/lib/weatherbridge
COPY production /app/production

USER weatherbridge
EXPOSE 8080
CMD ["uvicorn", "production.weatherbridge_app.api:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2", "--proxy-headers"]

