FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app
WORKDIR /app

COPY production/requirements-worker.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && useradd --create-home --uid 10001 weatherbridge \
    && mkdir -p /var/lib/weatherbridge/inbox /var/lib/weatherbridge/archive /var/lib/weatherbridge/store \
    && chown -R weatherbridge:weatherbridge /var/lib/weatherbridge
COPY weather_time_interp /app/weather_time_interp
COPY examples /app/examples
COPY tools /app/tools
COPY production /app/production

USER weatherbridge
CMD ["python", "-m", "production.weatherbridge_app.worker"]

