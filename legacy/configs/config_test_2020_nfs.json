{
  "source_zarr": "https://storage.googleapis.com/weatherbench2/datasets/era5/1959-2022-1h-360x181_equiangular_with_poles_conservative.zarr",
  "target_dir": "/workspace-SR006.nfs2/weather_data/time_interpolation",
  "years": [2020],
  "step_hours": 1,
  "source_variables": [
    "temperature",
    "u_component_of_wind",
    "v_component_of_wind",
    "specific_humidity",
    "geopotential"
  ],
  "rename_vars": {
    "temperature": "t",
    "u_component_of_wind": "u",
    "v_component_of_wind": "v",
    "specific_humidity": "q",
    "geopotential": "z"
  },
  "pressure_levels": [1000, 950, 900, 850],
  "chunk_out": {"time": 744, "level": -1, "latitude": -1, "longitude": -1},
  "compressor": {"cname": "zstd", "clevel": 5, "shuffle": "bitshuffle"},
  "storage_options": {},
  "max_retries": 5,
  "retry_initial_backoff_s": 5.0,
  "dask_scheduler": "threads",
  "force_overwrite": false
}
