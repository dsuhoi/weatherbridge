{
  "source_zarr": "gs://weatherbench2/datasets/era5/REPLACE_WITH_HOURLY_ERA5_ZARR_PATH.zarr",
  "target_dir": "~/data/weather_data/time_interpolation",
  "years": [2016, 2017, 2018, 2019, 2020],
  "step_hours": 1,
  "source_variables": [
    "temperature",
    "u_component_of_wind",
    "v_component_of_wind",
    "specific_humidity",
    "geopotential"
  ],
  "rename_vars": {
    "temperature": "t",
    "u_component_of_wind": "u",
    "v_component_of_wind": "v",
    "specific_humidity": "q",
    "geopotential": "z"
  },
  "pressure_levels": [1000, 950, 900, 850],
  "time_coord": "time",
  "lat_name": null,
  "lon_name": null,
  "level_name": null,
  "consolidated": true,
  "storage_options": {
    "token": "anon"
  },
  "chunk_out": {
    "time": 744,
    "level": -1,
    "latitude": 121,
    "longitude": 240
  }
}
